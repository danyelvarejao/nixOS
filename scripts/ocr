# Reads the text in a selected region and copies it to the clipboard.
region="$(slurp)" || exit 0
text="$(grim -g "$region" - | tesseract stdin stdout --psm 6 -l por+eng 2>/dev/null)"

if [[ -z "$text" ]]; then
  notify-send -t 2000 "No text found"
  exit 0
fi

printf '%s' "$text" | wl-copy
notify-send -t 2000 "Text copied"
